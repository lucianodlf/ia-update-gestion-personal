# Directorio de trabajo para sesiones de agentes (Claude Code CLI)
WORKFLOW_DIR=.agents/working-progress

# Telegram Bot Token (obtener desde @BotFather)
BOT_TOKEN=

# Mistral API Key (para OCR — plan Experiment, ver mistral.ai)
API_KEY_MISTRAL=

# Zrok Token (para túnel público hacia n8n — ver zrok.io)
ZROK_TOKEN=

# Google Sheet ID — cambiar para alternar entre planilla de test y producción
AGENT2_SHEET_ID=

# Workflows a activar con 'make start ACTIVATE=1' (IDs separados por coma)
N8N_ACTIVATE_WORKFLOWS=
