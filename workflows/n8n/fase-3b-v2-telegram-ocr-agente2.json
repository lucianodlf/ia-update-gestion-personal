      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\n\nif (!msg) {\n  return [{ json: { tipo: 'desconocido', chat_id: '', error: 'No hay mensaje' } }];\n}\n\nconst base = {\n  chat_id: String(msg.chat.id),\n  user: msg.from?.first_name || ''\n};\n\nif (msg.photo && msg.photo.length > 0) {\n  const foto = msg.photo[msg.photo.length - 1];\n  return [{ json: { ...base, tipo: 'foto', file_id: foto.file_id, caption: msg.caption || '' } }];\n}\n\nif (msg.document) {\n  return [{ json: { ...base, tipo: 'documento', file_id: msg.document.file_id, file_name: msg.document.file_name || 'archivo', mime_type: msg.document.mime_type || 'application/octet-stream', caption: msg.document.caption || '' } }];\n}\n\nif (msg.text && !msg.text.startsWith('/') && msg.text.length <= 50) {\n  return [{ json: { ...base, tipo: 'texto', texto: msg.text } }];\n}\n\nreturn [{ json: { ...base, tipo: 'desconocido', texto: msg.text || '' } }];"
      },
