    {
      "parameters": {
        "jsCode": "const binaryKeys = Object.keys($input.item.binary || {});\nconst binaryKey = binaryKeys[0] || 'data';\nconst bin = $input.item.binary?.[binaryKey];\n\nif (!bin) {\n  return [{ json: { error: 'No hay datos binarios', keys_encontradas: binaryKeys } }];\n}\n\nconst binaryBuffer = await this.helpers.getBinaryDataBuffer(0, binaryKey);\nconst base64 = binaryBuffer.toString('base64');\n\nconst prevData = $('Normalizar Mensaje').first().json;\n\nlet mimeType = bin.mimeType || 'application/octet-stream';\nif (mimeType === 'application/octet-stream') {\n  mimeType = prevData.tipo === 'foto' ? 'image/jpeg' : 'application/pdf';\n}\n\nreturn [{\n  json: {\n    tipo: prevData.tipo,\n    chat_id: prevData.chat_id,\n    file_id: prevData.file_id,\n    caption: prevData.caption || '',\n    mime_type: mimeType,\n    file_name: bin.fileName || 'archivo',\n    size_bytes: binaryBuffer.length,\n    base64: base64\n  }\n}];"
      },
      "id": "a-base64-v2",
      "name": "A Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst mimeType = data.mime_type || 'application/pdf';\nconst base64 = data.base64;\nconst isImage = mimeType.startsWith('image/');\nconst docType = isImage ? 'image_url' : 'document_url';\nconst doc = { type: docType, [docType]: 'data:' + mimeType + ';base64,' + base64 };\n\nconst fs = require('fs');\nconst classification = JSON.parse(fs.readFileSync('/data/classification.json', 'utf8'));\n\nfunction buildGuide(cls) {\n  const lines = [\n    'GUIA DE CLASIFICACION — completa \"detalle_inferido\" con la clave exacta si encontras coincidencia:',\n    ''\n  ];\n  for (const section of ['lista_fijos', 'lista_variables']) {\n    for (const [key, item] of Object.entries(cls[section] || {})) {\n      if (item.keys && item.keys.length) {\n        lines.push('- Si encontras: ' + item.keys.join(', ') + ' -> detalle_inferido: \"' + key + '\"');\n      }\n    }\n  }\n  lines.push('- Si no encontras ninguna coincidencia -> detalle_inferido: \"\"');\n  return lines.join('\\n');\n}\n\nconst guide = buildGuide(classification);\n\nconst prompt = [\n  'Sos un extractor de datos de comprobantes de pago argentinos. Extrae exactamente los cinco campos indicados.',\n  '',\n  'ESTRATEGIA: Escanea TODO el texto del documento antes de completar cada campo. Los datos pueden estar en cualquier parte: encabezado, cuerpo, pie, tablas, sellos.',\n  '',\n  'concepto - Nombre del servicio, impuesto o destinatario identificado.',\n  '  * Prioriza el nombre especifico del emisor o servicio, no el concepto generico del banco.',\n  '  * Si el banco dice \"VAR\" o \"Pago de servicio\" pero hay nombre de empresa -> usa el nombre de empresa.',\n  '  * Si es una transferencia a persona -> usa el nombre del destinatario.',\n  '  * Ejemplos: \"MONOTRIBUTO\", \"Epe - Santa Fe\", \"Damian Raul Frontera\".',\n  '',\n  'detalle_inferido - Clave de clasificacion del gasto (ver GUIA mas abajo).',\n  '  * Escanea TODOS los campos del documento: nombre de empresa, destinatario, CBU, CUIT, numero de cuenta.',\n  '  * Comparacion flexible: ignora mayusculas, minusculas, acentos, tildes y puntuacion.',\n  '    Ej: \"Monica\" = \"Monica\" | \"dietetica\" = \"Dietetica\" | \"epe santa fe\" = \"Epe - Santa Fe\"',\n  '  * Si encontras coincidencia -> completa con la clave exacta indicada en la GUIA. Sin modificar.',\n  '  * Si no hay coincidencia en ninguna parte del documento -> deja vacio \"\".',\n  '',\n  'fecha - Fecha del pago o emision.',\n  '  * Formato de salida: DD/MM/YYYY. Ignorar hora, zona horaria y segundos.',\n  '  * Si hay varias fechas -> usar la de pago o acreditacion, no la de vencimiento.',\n  '  * Excepción ARCA / IIBB: si el documento incluye una etiqueta \"Fecha y Hora\" → usar ESA fecha. Ignorar \"FECHA DE PAGO\" que puede corresponder a la fecha de procesamiento bancario posterior.',\n  '',\n  'importe - Monto total pagado como numero.',\n  '  * Sin simbolo de moneda ni separadores de miles. Punto decimal si aplica.',\n  '  * Ejemplos: \"$72.414,30\" -> 72414.3 | \"$ 52.939,51\" -> 52939.51 | \"$33.000\" -> 33000',\n  '  * Si hay subtotal + IVA + total -> usar el TOTAL.',\n  '  * Si no se encuentra -> 0.',\n  '',\n  'observacion - Datos de trazabilidad. Incluir en este orden si estan disponibles:',\n  '  1. Nombre del destinatario o empresa emisora',\n  '  2. CBU o alias',\n  '  3. CUIT / DNI / numero de cuenta',\n  '  4. Numero de comprobante, referencia o periodo',\n  '  * NO incluir: IDs de operacion alfanumericos largos (20+ caracteres), URLs, texto repetitivo.',\n  '',\n  guide\n].join('\\n');\n\nreturn [{\n  json: {\n    chat_id: data.chat_id,\n    tipo: data.tipo,\n    file_name: data.file_name || 'comprobante',\n    caption: data.caption || '',\n    body: {\n      model: 'mistral-ocr-latest',\n      document: doc,\n      document_annotation_format: {\n        type: 'json_schema',\n        json_schema: {\n          name: 'comprobante_pago',\n          schema: {\n            type: 'object',\n            properties: {\n              concepto: { type: 'string', description: 'Nombre del servicio, impuesto o destinatario. No usar genericos como VAR.' },\n              detalle_inferido: { type: 'string', description: 'Clave exacta de la guia de clasificacion que coincide. Vacio si no hay coincidencia.' },\n              fecha: { type: 'string', description: 'Fecha del pago en formato DD/MM/YYYY' },\n              importe: { type: 'number', description: 'Monto total pagado como numero sin simbolo ni separadores de miles' },\n              observacion: { type: 'string', description: 'Nombre de empresa/destinatario, CBU, CUIT/DNI, numero de comprobante. Sin hashes largos.' }\n            },\n            required: ['concepto', 'detalle_inferido', 'fecha', 'importe', 'observacion']\n          }\n        }\n      },\n      document_annotation_prompt: prompt,\n      include_image_base64: false\n    }\n  }\n}];"
      },
