    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst preparar = $('Preparar OCR').first().json;\nconst chatId = preparar.chat_id;\nconst caption = preparar.caption || '';\n\nif (!response.document_annotation) {\n  return [{ json: { chat_id: chatId, caption, mensaje: '❌ Sin respuesta de OCR', datos_ocr: null } }];\n}\n\nlet datos;\ntry {\n  datos = typeof response.document_annotation === 'string'\n    ? JSON.parse(response.document_annotation)\n    : response.document_annotation;\n} catch(e) {\n  return [{ json: { chat_id: chatId, caption, mensaje: `❌ Error parseando OCR: ${e.message}`, datos_ocr: null } }];\n}\n\nconst resultado = { ...datos };\nif (caption) resultado.caption = caption;\n\nreturn [{ json: {\n  chat_id: chatId,\n  datos_ocr: resultado,\n  mensaje: JSON.stringify(resultado, null, 2)\n} }];"
      },
