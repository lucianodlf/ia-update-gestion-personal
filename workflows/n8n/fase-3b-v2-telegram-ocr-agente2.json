    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst texto = data.texto || '';\n\nfunction isGarbage(word) {\n  const letters = word.toLowerCase().replace(/[^a-záéíóúñ]/gi, '');\n  if (letters.length < 3) return true;\n  const freq = {};\n  for (const c of letters) freq[c] = (freq[c] || 0) + 1;\n  const maxFreq = Math.max(...Object.values(freq));\n  return maxFreq / letters.length > 0.7;\n}\n\nconst words = texto.trim().split(/\\s+/);\nconst hasNumber = /\\d/.test(texto);\nconst hasRealWord = words.some(w => !isGarbage(w));\nconst valid = hasNumber || hasRealWord;\n\nconst errorMsg = valid ? '' : '❓ No entendí ese mensaje.\\n\\nPodés enviar:\\n• Texto: \"Monotributo $74500\", \"Gas listo\", \"IIBB 36700\"\\n• Foto o PDF de un comprobante de pago';\n\nreturn [{ json: { ...data, valid, error_msg: errorMsg } }];"
      },
